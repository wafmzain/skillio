# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side keys — used by the seed script (scripts/seed/) ONLY.
# DO NOT expose these to the client / Vite import.meta.env.
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq AI Configuration
VITE_GROQ_API_KEY=your_groq_api_key_here

# Note: Never commit .env file to version control
# Copy this file to .env and fill in your actual values
# Get Groq API key from: https://console.groq.com/keys
# Get the service-role key from Supabase: Settings → API → service_role secret
